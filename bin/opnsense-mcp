#!/bin/sh
# Launcher for the opnsense MCP server (macOS / Linux; Windows via Git Bash `sh`).
# Picks the prebuilt binary for this OS/arch, verifies its sha256 against
# bin/SHA256SUMS, unpacks it once into a user cache, and execs it. If no
# prebuilt binary fits, builds from source with `go` (stdlib only).
# stdout is reserved for MCP JSON-RPC: every diagnostic goes to stderr.
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
die() { echo "opnsense-mcp: $*" >&2; exit 1; }
case $(uname -s) in
  Linux) os=linux ;; Darwin) os=darwin ;; MINGW*|MSYS*|CYGWIN*) os=windows ;;
  *) os=unknown ;;
esac
case $(uname -m) in
  x86_64|amd64) arch=amd64 ;; aarch64|arm64) arch=arm64 ;; *) arch=unknown ;;
esac
ext=''; [ "$os" = windows ] && ext=.exe
name="opnsense-mcp-$os-$arch$ext"
sha() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1; }
cache="${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/opnsense-mcp"

# 1. A local `make build` output next to this script.
[ -x "$root/bin/$name" ] && exec "$root/bin/$name" "$@"

# 2. The committed, compressed prebuilt binary, verified and cached by checksum.
want=$(awk -v n="$name" '$2 == n { print $1 }' "$root/bin/SHA256SUMS" 2>/dev/null || true)
if [ -n "$want" ] && [ -f "$root/bin/$name.gz" ]; then
  bin="$cache/$want/$name"
  if [ ! -x "$bin" ] || [ "$(sha "$bin")" != "$want" ]; then
    mkdir -p "$cache/$want"
    tmp="$bin.tmp.$$"
    gzip -dc "$root/bin/$name.gz" > "$tmp" || { rm -f "$tmp"; die "could not unpack bin/$name.gz"; }
    [ "$(sha "$tmp")" = "$want" ] || { rm -f "$tmp"; die "checksum mismatch for $name; refusing to run it"; }
    chmod 755 "$tmp" && mv -f "$tmp" "$bin"
  fi
  exec "$bin" "$@"
fi

# 3. Build from source (Go standard library only, no network needed).
if command -v go >/dev/null 2>&1; then
  mkdir -p "$cache/src"
  # go needs a build cache; give it one when the host passes no HOME/XDG_CACHE_HOME.
  [ -n "${GOCACHE:-}${HOME:-}${XDG_CACHE_HOME:-}" ] || export GOCACHE="$cache/go-build"
  bin="$cache/src/opnsense-mcp$ext"
  (cd "$root" && CGO_ENABLED=0 go build -trimpath -o "$bin" ./cmd/opnsense-mcp) >&2 || die "go build failed"
  exec "$bin" "$@"
fi
die "no prebuilt binary for $(uname -s)/$(uname -m) and Go is not installed; install Go and run 'make build' in $root"
